service vendor.health-2.1-service /vendor/bin/hw/android.hardware.health@2.1-service
    class hal
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    seclabel u:r:recovery:s0

service vendor.charger /vendor/bin/hw/android.hardware.health@2.1-service --charger
    class charger
    seclabel u:r:charger_vendor:s0
    user system
    group system wakelock input graphics
    capabilities SYS_BOOT WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w